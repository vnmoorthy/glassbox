# Glassbox works fully offline. Add any of these keys to switch that partner adapter from "local" to "live".
PORT=8787

# Senso — trusted context layer (https://docs.senso.ai)
SENSO_API_KEY=
# Airbyte — merchant data connectors
AIRBYTE_API_KEY=
# cognee Cloud — personal memory graph (base URL is your tenant, e.g. https://<tenant>.aws.cognee.ai)
COGNEE_API_KEY=
COGNEE_BASE_URL=
# Superlinked SIE Serverless — semantic ranking (key looks like sk-sie-...)
SUPERLINKED_API_KEY=
SUPERLINKED_MODEL=Qwen/Qwen3-Embedding-4B
# Arcee AI — Pareto-frontier reasoning (key looks like rcai-...)
ARCEE_API_KEY=
ARCEE_MODEL=auto
# Statsig — guardrail flags (server secret key)
STATSIG_SERVER_KEY=
STATSIG_GATE=glassbox_autobuy
# Persona — human verification of mandates
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
# SingleStore — real-time ledger store (Data API)
SINGLESTORE_HOST=
SINGLESTORE_USER=
SINGLESTORE_PASSWORD=
SINGLESTORE_DATABASE=
# Amplitude — agent analytics (project API key)
AMPLITUDE_API_KEY=
# Guild AI — agent evaluation (GUILD_API_KEY = "<api_key_id>:<api_key_secret>", workspace needs an API trigger)
GUILD_API_KEY=
GUILD_OWNER=
GUILD_WORKSPACE=
# Firedrill — no API key; run `npx firedrill-run run` against GET /api/drills/firedrill.json
